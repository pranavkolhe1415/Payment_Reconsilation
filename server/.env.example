# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URL
# Local standalone example:
MONGODB_URI=mongodb://localhost:27017/reconx
# Authenticated / Replica Set / Atlas example:
# MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?retryWrites=true&w=majority

# Client Application URL (for CORS policy)
CLIENT_URL=http://localhost:5173
